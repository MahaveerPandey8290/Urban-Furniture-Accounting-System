# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 15 connection string (local pgAdmin 4)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/urbanfurniture

# Separate DB for integration tests — must be a DIFFERENT database name
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/urbanfurniture_test

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-64-byte-random-hex-string
JWT_REFRESH_SECRET=change-me-to-another-64-byte-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ─── Seed Admin ───────────────────────────────────────────────────────────────
# REQUIRED in production. Must meet password policy:
#   - minimum 8 chars, at least 1 lowercase, 1 uppercase, 1 special character
# loginId: 6-12 chars, alphanumeric + underscore only
SEED_ADMIN_LOGIN_ID=admin001
SEED_ADMIN_PASSWORD=Admin@1234

# ─── Company ──────────────────────────────────────────────────────────────────
SEED_COMPANY_NAME=Urban Furniture Pvt Ltd

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated explicit allowlist. Never use wildcard (*).
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Stored OUTSIDE the web root. Magic-byte validated, random filenames.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=2

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ─── Email (stubbed — ConsoleEmailService) ────────────────────────────────────
# Used to build password reset links. Replace with real service in production.
APP_URL=http://localhost:3000
